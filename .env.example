# Copy this file to .env and fill it in. Never commit .env or paste these values anywhere public.
DISCORD_TOKEN=paste-your-bot-token-here

# Optional: lets the bot understand any phrasing ("bro I carried the whole Costco run").
# Without it, built-in phrase matching handles the common ones.
ANTHROPIC_API_KEY=
