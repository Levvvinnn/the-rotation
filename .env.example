# Copy this file to .env and fill it in. Never commit .env or paste these values anywhere public.
DISCORD_TOKEN=paste-your-bot-token-here

# Local calendar used for "yesterday", "last night", and weekday names.
ROTATION_TIMEZONE=America/Phoenix

# Optional natural-language fallback. Both values are required to enable it.
# Only relevant messages that built-in rules cannot parse are sent to this service.
ANTHROPIC_API_KEY=
ROTATION_MODEL=

# Optional SQLite file location (keep it on persistent disk when hosting).
# ROTATION_DB=/absolute/path/to/rotation.db
